# Real-game assets (large binaries / proprietary APKs) - NOT for GitHub
64-bit/
other64-bit/
other32-bit/
ilmet/
apk/
likey_dump/
samples/

# Standard input directories — keep folders, ignore dropped files
apks/*
!apks/.gitkeep
libs/*
!libs/.gitkeep
metadata/*
!metadata/.gitkeep

# Dump outputs (script.json / stringliteral.json / dump.cs land in -o dirs)
DumpResult/*
!DumpResult/.gitkeep
out_*/
dump.txt
dump_xor.txt
*.log
script.json
stringliteral.json
dump.cs

# Python cache / editor junk
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.idea/
.vscode/
*.swp

# Test fixture binaries regenerated by make_test_elf.py
tests/libil2cpp_test.so
tests/libil2cpp_test32.so
tests/libil2cpp_scan_test.so
tests/libil2cpp_scan_test32.so
# Test output directories
tests/sweep/
tests/out_elf/
tests/out_elf32/
tests/out_scan/
tests/out_scan32/
tests/out_xor/
tests/out_xor32/

# Protect scanned memory dumps (large, game-specific)
*.memorydump.so
global-metadata.decrypted.*.dat

# Packaging artifacts
build/
dist/
*.egg-info/

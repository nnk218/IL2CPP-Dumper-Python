# Real-game assets (large binaries / proprietary APKs) - NOT for GitHub
64-bit/
other64-bit/
other32-bit/
ilmet/
apk/
likey_dump/
samples/

# Standard input directory — keep folders, ignore dropped files
DumpPayload/apk/*
!DumpPayload/apk/.gitkeep
DumpPayload/lib/*
!DumpPayload/lib/.gitkeep
DumpPayload/metadata/*
!DumpPayload/metadata/.gitkeep

# Dump outputs (script.json / stringliteral.json / dump.cs land in -o dirs)
# Default runs write to DumpResult/<timestamp>/ — ignore the whole tree but keep .gitkeep
DumpResult/
!DumpResult/.gitkeep
# Nested DumpResult anywhere in the tree (e.g. explicit -o paths)
**/DumpResult/
!**/DumpResult/.gitkeep
# Individual dump outputs, wherever they land
**/script.json
**/stringliteral.json
**/Strings.txt
**/dump.cs
**/DummyDll/
out_*/
dump.txt
dump_xor.txt
*.log

# Python cache / editor junk
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.idea/
.vscode/
*.swp

# Test fixture binaries regenerated by make_test_elf.py
tests/libil2cpp_test.so
tests/libil2cpp_test32.so
tests/libil2cpp_scan_test.so
tests/libil2cpp_scan_test32.so
# Test output directories
tests/sweep/
tests/out_elf/
tests/out_elf32/
tests/out_scan/
tests/out_scan32/
tests/out_xor/
tests/out_xor32/

# Protect scanned memory dumps (large, game-specific)
*.memorydump.so
global-metadata.decrypted.*.dat

# Packaging artifacts
build/
dist/
*.egg-info/
